{"sections":{"main":{"type":"static-product","blocks":{"title":{"type":"title","settings":{}},"2e128dd1-7dbd-45da-966d-745faa090a0f":{"type":"rating","settings":{}},"price":{"type":"price","settings":{}},"custom_liquid_gUBmJ6":{"type":"custom-liquid","settings":{"custom_liquid":"<div id=\"sku-container\" style=\"margin: 16px 0; padding: 12px; background-color: #f5f5f5; border-radius: 4px; font-size: 14px;\">\n  <strong style=\"font-weight: 600; margin-right: 8px;\">SKU:<\/strong>\n  <span id=\"sku-value\" style=\"color: #666; font-family: monospace;\">{{ product.selected_or_first_available_variant.sku | default: 'N\/A' }}<\/span>\n<\/div>\n\n<script>\n(function() {\n  const skuValueElement = document.getElementById('sku-value');\n  if (!skuValueElement) return;\n  \n  \/\/ Get all variant data from the page\n  const variantData = {};\n  {% for variant in product.variants %}\n    variantData[{{ variant.id }}] = '{{ variant.sku | default: \"N\/A\" }}';\n  {% endfor %}\n  \n  \/\/ Function to update SKU display\n  function updateSKU(variantId) {\n    if (variantData[variantId]) {\n      skuValueElement.textContent = variantData[variantId];\n    }\n  }\n  \n  \/\/ Listen for variant selection changes\n  document.addEventListener('change', function(e) {\n    if (e.target && e.target.name === 'id') {\n      updateSKU(parseInt(e.target.value));\n    }\n  }, true);\n  \n  \/\/ Also listen for custom variant change events\n  document.addEventListener('variant:change', function(e) {\n    if (e.detail && e.detail.variant && e.detail.variant.id) {\n      updateSKU(e.detail.variant.id);\n    }\n  });\n})()\n<\/script>"}},"12214949-0a99-47d0-875d-57cf008e67f8":{"type":"inventory_status","settings":{"inventory_display":"low_stock_threshold","inventory_transfer_notice":true}},"470d7baa-1f3c-49c2-b147-9e4d935fa956":{"type":"form","settings":{"enable_local_pickup":true,"show_gift_card_recipient_form":false}},"description":{"type":"description","settings":{}}},"block_order":["title","2e128dd1-7dbd-45da-966d-745faa090a0f","price","custom_liquid_gUBmJ6","12214949-0a99-47d0-875d-57cf008e67f8","470d7baa-1f3c-49c2-b147-9e4d935fa956","description"],"settings":{"gallery_aspect_ratio":"square","gallery_image_crop":false,"gallery_thumbnail_position":"below","gallery_video_autoplay":true,"gallery_video_looping":true,"gallery_hover_zoom":"disabled","gallery_click_to_zoom":"always"}},"recommendations":{"type":"static-product-recommendations","settings":{"show_product_recommendations":true,"product_recommendations_heading":"You may also like"}},"recently-viewed":{"type":"static-recently-viewed","settings":{"enable_recently_viewed_products":true}}},"order":["main","recommendations","recently-viewed"]}